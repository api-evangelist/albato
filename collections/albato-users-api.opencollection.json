{
  "opencollection": "1.0.0",
  "info": {
    "name": "Albato Automations Users API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List team users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://albato.com/api/v1/teams/:teamId/users",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path",
                "description": "Team ID"
              }
            ]
          },
          "docs": "Returns users for a specific team."
        },
        {
          "info": {
            "name": "Create a team user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://albato.com/api/v1/teams/:teamId/users",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds a new user to a team."
        }
      ]
    }
  ],
  "bundled": true
}